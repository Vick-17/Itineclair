POSTGRES_DB=itineclair
POSTGRES_USER=itineclair

# NE JAMAIS utiliser cette valeur en production réelle.
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD

# Le port HTTP interne n'est exposé que sur la boucle locale. Un frontal HTTPS
# installé sur le même serveur doit publier l'application sur Internet.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Laisser désactivé tant qu'un abonnement Open-Meteo commercial n'est pas prêt.
ITINECLAIR_WEATHER_ENABLED=false
ITINECLAIR_WEATHER_BASE_URL=https://customer-api.open-meteo.com
ITINECLAIR_WEATHER_API_KEY=
